# Local dev env for infra/docker-compose.local.yml
# Copy to infra/.env.local (gitignored) and fill values.

# Point these at your DGX OpenAI-compatible endpoints (or other compatible servers)
NVIDIA_LLM_URL=http://127.0.0.1:8000/v1
NVIDIA_API_KEY=change_me
NVIDIA_MODEL=qwen/qwen3.5-397b-a17b

NVIDIA_EMBED_URL=http://127.0.0.1:8001
NVIDIA_EMBED_MODEL=NV-Embed-QA

# Qdrant collection
QDRANT_COLLECTION=jw_research

# JW live ingest knobs (keep small to avoid blocks)
JW_LIVE_INGEST_ENABLED=true
JW_LIVE_INGEST_MAX_URLS=2
JW_LIVE_INGEST_MAX_CHUNKS=6
JW_USER_AGENT=JW_Research_Personal_Bot/0.1 (private study; contact: owner)
