# Copy to .env (gitignored). Never commit real values.
HF_TOKEN=hf_xxx_your_huggingface_token
DGX_API_KEY=generate_a_long_random_string
CLOUDFLARE_TUNNEL_TOKEN=eyJ_your_cloudflared_token

# Optional: Qdrant API key (if you enable auth on Qdrant)
QDRANT_API_KEY=<your-qdrant-api-key>

# Optional: embedding model name passed to the embedder (web + indexer)
NVIDIA_EMBED_MODEL=NV-Embed-QA
