[Unit]
Description=JW Research scheduled crawler run
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/JW_Research
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/jw-research/crawler.env
ExecStart=/bin/bash -lc '%h/Documents/JW_Research/crawler/.venv/bin/python -m crawler.run --spider "${CRAWLER_SPIDER:-wol}" ${CRAWLER_LIMIT:+--limit "${CRAWLER_LIMIT}"}'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
