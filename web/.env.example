# Environment Configuration Template
# For LOCAL DEVELOPMENT: Copy to .env.local and fill in values
# For PRODUCTION: Add these variables in Vercel Dashboard → Project Settings → Environment Variables

# ==================== PRODUCTION (Cloudflare Tunnel) ====================
# If BACKEND_URL is set, /api/chat will proxy to BACKEND_URL/api/chat.
# The target must accept POST requests at /api/chat.
# Keep backend-local vars set there too if your proxy target depends on them.
BACKEND_URL=https://your-backend.example.com

# If running retrieval from this app (no proxy), set these values:
QDRANT_URL=https://your-qdrant-host.example.com
QDRANT_API_KEY=your_qdrant_api_key
NVIDIA_LLM_URL=https://your-llm-endpoint.example.com
NVIDIA_EMBED_URL=https://your-embed-endpoint.example.com
NVIDIA_API_KEY=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
NVIDIA_MODEL=Qwen/Qwen2.5-14B-Instruct
NVIDIA_EMBED_MODEL=BAAI/bge-large-en-v1.5
QDRANT_COLLECTION=jw_research
JW_LIVE_INGEST_ENABLED=true

# Upstream timeouts (ms) for faster failover under outages
BACKEND_PROXY_TIMEOUT_MS=5000
NVIDIA_EMBED_TIMEOUT_MS=5000
QDRANT_TIMEOUT_MS=5000
JW_LIVE_INGEST_TIMEOUT_MS=8000

# ==================== LOCAL DEVELOPMENT ====================
# Use these for local development (docker compose up -d in infra/)

# LLM Configuration
NVIDIA_LLM_URL=http://localhost:8000
NVIDIA_MODEL=Qwen/Qwen2.5-14B-Instruct

# Embeddings Configuration  
NVIDIA_EMBED_URL=http://localhost:8001
NVIDIA_EMBED_MODEL=BAAI/bge-large-en-v1.5

# Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=jw_research

# API Authentication
NVIDIA_API_KEY=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
# QDRANT_API_KEY=optional_qdrant_key

# JW Live Ingestion
JW_LIVE_INGEST_ENABLED=true
JW_LIVE_INGEST_MAX_URLS=2
JW_LIVE_INGEST_MAX_CHUNKS=6
JW_USER_AGENT=JW_Research_Personal_Bot/0.1
