NVIDIA_EMBED_MODEL=baai/bge-m3

# Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=jw_research

# API Authentication
NVIDIA_API_KEY=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
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6ZWI3ODVmZjgtNjcwOS00YjljLTk0Y2UtNWUyMGQ5OTNjNDdlIn0.sOjUA2SiC6ocNqi2NWRI5aZb357aazyQJ_21Lv68VcE

# JW Live Ingestion
JW_LIVE_INGEST_ENABLED=true
JW_LIVE_INGEST_MAX_URLS=2
