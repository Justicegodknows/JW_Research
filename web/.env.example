# Environment Configuration Template
# For LOCAL DEVELOPMENT: Copy to .env.local and fill in values
# For PRODUCTION: Add these variables in Vercel Dashboard → Project Settings → Environment Variables

# ==================== PRODUCTION (Cloudflare Tunnel) ====================
# If BACKEND_URL is set, /api/chat will proxy to BACKEND_URL/api/chat.
# The target must accept POST requests at /api/chat.
# Keep backend-local vars set there too if your proxy target depends on them.
BACKEND_URL=https://theocracy.theocracy.me
# Optional: custom path on DGX backend (default: /api/chat)
BACKEND_CHAT_PATH=/api/chat
# Recommended default: allow local fallback if the proxy target is unavailable
# or misconfigured for POST /api/chat.
BACKEND_ALLOW_LOCAL_FALLBACK=true

# If running retrieval from this app (no proxy), set these values:
QDRANT_URL=https://qdrant.theocracy.me
NVIDIA_LLM_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBED_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=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
NVIDIA_MODEL=jw-llm
NVIDIA_EMBED_MODEL=baai/bge-m3
QDRANT_COLLECTION=jw_research
JW_LIVE_INGEST_ENABLED=true

# Chat creativity + retrieval depth tuning
# Higher creativity defaults
JW_CHAT_TEMPERATURE=1.25
JW_CHAT_TOP_P=0.98
JW_CHAT_TOP_K=60
JW_CHAT_PRESENCE_PENALTY=0.6
JW_CHAT_FREQUENCY_PENALTY=0.3

# Deep retrieval with mixed source blending (scraped web + downloaded books)
JW_RETRIEVAL_TOP_K=500
JW_RETRIEVAL_FINAL_K=50
JW_RETRIEVAL_MMR_LAMBDA=0.58

# Prompt context budget in characters
JW_CONTEXT_BUDGET_CHARS=5000

# Upstream timeouts (ms) for faster failover under outages
BACKEND_PROXY_TIMEOUT_MS=5000
NVIDIA_EMBED_TIMEOUT_MS=5000
QDRANT_TIMEOUT_MS=5000
JW_LIVE_INGEST_TIMEOUT_MS=8000

# ==================== LOCAL DEVELOPMENT ====================
