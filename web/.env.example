# Environment Configuration Template
# For LOCAL DEVELOPMENT: Copy to .env.local and fill in values
# For PRODUCTION: Add these variables in Vercel Dashboard → Project Settings → Environment Variables

# ==================== PRODUCTION (Cloudflare Tunnel) ====================
# Uncomment and use these for production deployment
# QDRANT_URL=https://qdrant.theocracy.me
# NVIDIA_LLM_URL=https://llm.theocracy.me
# NVIDIA_EMBED_URL=https://embed.theocracy.me
# NVIDIA_API_KEY=<your-nvidia-api-key>

# ==================== LOCAL DEVELOPMENT ====================
# Use these for local development (docker compose up -d in infra/)

# LLM Configuration
NVIDIA_LLM_URL=http://localhost:8000
NVIDIA_MODEL=jw-llm

# Embeddings Configuration  
NVIDIA_EMBED_URL=http://localhost:8001
NVIDIA_EMBED_MODEL=NV-Embed-QA

# Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=jw_research

# API Authentication
NVIDIA_API_KEY=<development-api-key>
# QDRANT_API_KEY=optional_qdrant_key

# JW Live Ingestion
JW_LIVE_INGEST_ENABLED=true
JW_LIVE_INGEST_MAX_URLS=2
JW_LIVE_INGEST_MAX_CHUNKS=6
JW_USER_AGENT=JW_Research_Personal_Bot/0.1
